subplot(3,1,1)
t = linspace(0,0.1);
x_a = 3*sin(100*%pi*t)
plot(t, x_a, style = 1)
xtitle("xa(t)");

n = linspace(1,30);
subplot(3,1,2)
xn = 3*sin(%pi*n/3);
plot2d3(n, xn, style = 2)
xtitle("x(n)");

subplot(3,1,3)
delta = 0.1;
x_qn = floor(xn/delta)*delta;
plot2d3(n, x_qn, style = 3)
xtitle("xq(n)");
